# =============================================================================
# ARQUIVO: .env.example (Localização: /backend/.env.example)
# PROJETO: GlicoCare — Sistema Integrado de Apoio ao DM1
# =============================================================================

# Banco de Dados TiDB Cloud (Serverless MySQL com SSL na porta 4000)
DB_HOST=gateway01.sa-east-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_NAME=glicocare_db
DB_USER=seu_usuario_tidb.root
DB_PASS=sua_senha_aqui
DB_SSL=true

# Para desenvolvimento local com MySQL/XAMPP:
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=glicocare_db
# DB_USER=root
# DB_PASS=
# DB_SSL=false

# Configurações de Fuso Horário, JWT e CORS para Produção
APP_TIMEZONE=America/Sao_Paulo
JWT_SECRET=glicocare_segredo_jwt_producao_2026_porto_seguro
CORS_ALLOWED_ORIGIN=*

# =============================================================================
# CONTROLE DE FASES DO GLICOCARE
# Fase 1: false (Blog/CMS + Perfis/Contas + Cuidado Diário)
# Fase 2: true (Teleatendimentos, Consultas Nativas e Split Pix)
# =============================================================================
TELEMEDICINA_ATIVA=false

# =============================================================================
# VÍDEO NATIVO E TELEMEDICINA (Daily.co REST API & SDK Embarcado - FASE 2)
# Obtenha sua chave de API em: https://dashboard.daily.co/developers
# Se omitido ou em branco, a plataforma opera automaticamente em Modo Simulação Segura
# =============================================================================
# DAILY_API_KEY=sua_chave_daily_co_aqui
