# Configurações do Banco de Dados GlicoCare
# Para TiDB Cloud, utilize os dados fornecidos na tela de conexão após criar a instância:

DB_HOST=gateway01.sa-east-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_NAME=glicocare_db
DB_USER=seu_usuario_tidb.root
DB_PASS=sua_senha_aqui
DB_SSL=true

# Para desenvolvimento local com MySQL/XAMPP:
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=glicocare_db
# DB_USER=root
# DB_PASS=
# DB_SSL=false

# =============================================================================
# VÍDEO NATIVO E TELEMEDICINA (Daily.co REST API & SDK Embarcado)
# Obtenha sua chave de API em: https://dashboard.daily.co/developers
# Se omitido ou em branco, a plataforma opera automaticamente em Modo Simulação Segura
# (Preview Local com WebRTC/MediaDevices e sala de espera demonstrativa)
# =============================================================================
# DAILY_API_KEY=sua_chave_daily_co_aqui

